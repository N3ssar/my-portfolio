# Copy to .env.local for local development. Never commit real values.

# Resend (email delivery). Until a custom domain is verified, mail is sent from
# onboarding@resend.dev, which only delivers to the address that owns the Resend account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=n3ssar.swe@gmail.com

# Telegram bot (message delivery): the token from BotFather, and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstash Redis (rate limiting). Required in production; without it the contact
# route refuses messages. Local development falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=
